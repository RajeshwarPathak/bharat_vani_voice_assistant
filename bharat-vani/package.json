{
  "name": "bharat-vani",
  "productName": "Bharat Vani",
  "private": true,
  "version": "1.0.0",
  "description": "Bharat Vani — AI Desktop Assistant for Windows",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "app": "electron .",
    "electron": "electron .",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "dist": "npm run build && electron-builder --win --x64",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.bharatvani.assistant",
    "productName": "Bharat Vani",
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.png",
      "shortcutName": "Bharat Vani"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "node_modules/**/*",
      ".env"
    ],
    "extraResources": [
      ".env"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "@google/genai@2.22.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "electron-winstaller@5.4.0": true
  }
}
